{
  "manifest_version": 3,
  "name": "Yurt browser bridge",
  "version": "0.0.1",
  "description": "Lets a Playwright script in a Yurt sandbox drive tabs it opens in this browser.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "bridge.js"
  },
  "externally_connectable": {
    "matches": [
      "https://yurt-playground.pages.dev/",
      "https://yurt-playground.pages.dev/?*",
      "https://yurt-playground.pages.dev/index.html*"
    ]
  }
}
