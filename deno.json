{
  "unstable": ["sloppy-imports"],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@xterm/xterm": "npm:@xterm/xterm@5.5.0",
    "@xterm/addon-fit": "npm:@xterm/addon-fit@0.10.0",
    "@xterm/addon-unicode11": "npm:@xterm/addon-unicode11@0.8.0",
    "@xterm/addon-webgl": "npm:@xterm/addon-webgl@0.18.0",
    "playwright": "npm:playwright@1.55.0",
    "fzstd": "npm:fzstd@0.1.1",
    "@yurt/kernel-host-interface-js": "../yurtos-kernel/packages/kernel-host-interface-js/mod.ts",
    "@yurt/tar-image": "../yurtos-kernel/packages/runner/src/vfs/tar-image-root-provider.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.window", "dom"]
  },
  "exclude": [
    ".worktrees",
    "worktrees",
    "public/boot.bundle.js",
    "public/coordinator.bundle.js",
    "public/worker_bootstrap.js"
  ],
  "lint": {
    "exclude": [
      ".worktrees",
      "worktrees",
      "public/boot.bundle.js",
      "public/coordinator.bundle.js",
      "public/worker_bootstrap.js"
    ],
    "rules": {
      "exclude": ["no-sloppy-imports"]
    }
  },
  "fmt": {
    "exclude": [
      ".worktrees",
      "worktrees",
      "public/boot.bundle.js",
      "public/coordinator.bundle.js",
      "public/worker_bootstrap.js"
    ]
  },
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check '**/*.ts'",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run",
    "pin": "deno run --allow-read --allow-write --allow-env --allow-net scripts/pin-artifacts.ts",
    "serve": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run scripts/serve.ts",
    "build-static": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run scripts/build-static.ts"
  }
}
